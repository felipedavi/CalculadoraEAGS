<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="io.github.felipedavi.eags_calculator.MainFragment"
        android:label="@string/main_fragment"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/navigateToResultFragment"
            app:destination="@id/resultFragment"
            app:enterAnim="@anim/nav_default_pop_enter_anim"
            app:launchSingleTop="true"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="io.github.felipedavi.eags_calculator.ResultFragment"
        android:label="@string/result_fragment"
        tools:layout="@layout/fragment_result" >
        <argument
            android:name="pt"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="esp"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>
</navigation>